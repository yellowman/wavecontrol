# Copy this file to wavecontrol.env. Do not commit the populated file.
# Values are taken literally; do not wrap them in quotes.

WAVECONTROL_DSN=postgres://wavecontrol:CHANGE_ME@127.0.0.1:5432/wavecontrol?sslmode=disable
WAVECONTROL_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WAVECONTROL_DATA_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES

# Required only for the first start of an empty database. Remove both lines
# after the administrator account has been created successfully.
WAVECONTROL_BOOTSTRAP_USERNAME=wavecontrol-admin
WAVECONTROL_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_ONE_TIME_PASSWORD

# Optional path overrides. The run script already supplies executable-relative
# -workdir and -webroot values, so these normally stay unset.
# WAVECONTROL_WORKDIR=C:\WaveControl
# WAVECONTROL_WEBROOT=C:\WaveControl\web
