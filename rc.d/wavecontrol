#!/bin/ksh
#
# $OpenBSD$

# waveControl reads persistent secrets from a root-owned environment file.
# Never generate the JWT or data-encryption key at service start: doing so
# invalidates sessions and makes encrypted device credentials unreadable.
daemon="/usr/local/bin/wavecontrol"
daemon_user="root" # the daemon performs its own privilege separation
wavecontrol_env_file="/etc/wavecontrol/wavecontrol.env"
pexp="/usr/local/bin/wavecontrol.*"

. /etc/rc.d/rc.subr

rc_reload=NO

rc_start() {
	if [[ ! -r "${wavecontrol_env_file}" ]]; then
		echo "${wavecontrol_env_file} is required and must contain persistent waveControl secrets" >&2
		return 1
	fi

	set -a
	. "${wavecontrol_env_file}" || return 1
	set +a

	if [[ -z "${WAVECONTROL_DSN}" || -z "${WAVECONTROL_JWT_SECRET}" || -z "${WAVECONTROL_DATA_KEY}" ]]; then
		echo "WAVECONTROL_DSN, WAVECONTROL_JWT_SECRET, and WAVECONTROL_DATA_KEY are required" >&2
		return 1
	fi

	rc_exec "${daemon} ${daemon_flags}"
}

rc_cmd $1
