# Install as /etc/wavecontrol/wavecontrol.env, owned by root and mode 0600.
# Generate the two persistent secrets once; do not rotate WAVECONTROL_DATA_KEY
# without first re-encrypting every stored operational credential.
WAVECONTROL_DSN='postgres://wavecontrol:replace-me@127.0.0.1/wavecontrol?sslmode=disable'
WAVECONTROL_JWT_SECRET='replace-with-output-of-openssl-rand-base64-48'
WAVECONTROL_DATA_KEY='replace-with-output-of-openssl-rand-base64-32'

# Required only for the first startup of an empty database. Remove both lines
# after the initial administrator has been created.
# WAVECONTROL_BOOTSTRAP_USERNAME='wavecontrol-admin'
# WAVECONTROL_BOOTSTRAP_PASSWORD='replace-with-a-strong-password'
