[Unit]
Description=waveControl Device Management
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=_wavecontrol
Group=_wavecontrol
WorkingDirectory=/var/wavecontrol
EnvironmentFile=/etc/wavecontrol/wavecontrol.env
ExecStart=/usr/local/bin/wavecontrol -d
Restart=on-failure
RestartSec=5

# The daemon needs network access and write access only to its working tree.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/wavecontrol
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
