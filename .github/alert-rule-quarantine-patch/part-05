+  const detail = document.createElement('div')
+  detail.className = 'alert-rule-quarantine-detail'
+  detail.dataset.alertQuarantineDetail = 'true'
+
+  const summary = document.createElement('span')
+  const when = formatQuarantineTime(rule.quarantined_at)
+  summary.textContent = `Automatically disabled${when ? ` ${when}` : ''}`
+  detail.appendChild(summary)
+
+  const reason = document.createElement('small')
+  reason.textContent = String(rule.quarantine_reason || '')
+  detail.appendChild(reason)
+  nameCell.appendChild(detail)
+}
