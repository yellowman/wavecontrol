+function makeQuarantineBanner(count) {
+  const banner = document.createElement('div')
+  banner.className = 'alert-rule-quarantine-banner'
+  banner.dataset.alertQuarantineBanner = 'true'
+  banner.setAttribute('role', 'alert')
+
+  const title = document.createElement('strong')
+  title.textContent = `${count} invalid alert rule${count === 1 ? '' : 's'} automatically disabled`
+  banner.appendChild(title)
+
+  const explanation = document.createElement('p')
+  explanation.textContent = `WaveControl kept running and excluded ${count === 1 ? 'this rule' : 'these rules'} from evaluation. Repair the highlighted configuration and save it, or delete it if it is obsolete.`
+  banner.appendChild(explanation)
+  return banner
+}
