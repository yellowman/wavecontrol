+    return
+  }
+  const rules = quarantinedRules()
+  if (rules.length === 0) {
+    toastFingerprint = ''
+    return
+  }
+  const fingerprint = rules.map(rule => `${rule.id}:${rule.quarantined_at || ''}`).join('|')
+  if (fingerprint === toastFingerprint) return
+  toastFingerprint = fingerprint
