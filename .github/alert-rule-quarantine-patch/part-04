+    badge.textContent = ''
+    badge.removeAttribute('title')
+    return
+  }
+  badge.textContent = rules.length > 9 ? '9+' : String(rules.length)
+  badge.title = `${rules.length} invalid alert rule${rules.length === 1 ? '' : 's'} automatically disabled`
