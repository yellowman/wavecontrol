+function ensureWarningBadge() {
+  const alertsLink = document.querySelector('a[data-page="alerts"]')
+  if (!alertsLink) return null
+  let badge = document.getElementById('alertRuleWarningBadge')
+  if (!badge) {
+    badge = document.createElement('span')
+    badge.id = 'alertRuleWarningBadge'
+    badge.className = 'nav-alert-rule-warning hidden'
