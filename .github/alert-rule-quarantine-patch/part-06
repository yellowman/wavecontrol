+      announceQuarantine()
+      queueDecoration()
+    } catch (_) {
+      // This is advisory UI. Keep the last known state on a transient API
+      // failure and never interfere with the main Alerts page.
+    } finally {
+      refreshPromise = null
+    }
+  })()
+  return refreshPromise
+}
