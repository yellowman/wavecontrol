+func (c *quarantineTestConn) ExecContext(_ context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	copied := append([]driver.NamedValue(nil), args...)
+	c.execs = append(c.execs, quarantineTestExec{query: query, args: copied})
+	if c.failExec {
+		c.failExec = false
+		return nil, errors.New("injected quarantine write failure")
+	}
+	return driver.RowsAffected(1), nil
